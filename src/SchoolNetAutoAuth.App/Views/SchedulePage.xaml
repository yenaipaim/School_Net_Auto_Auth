<Page
    x:Class="SchoolNetAutoAuth.App.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid Padding="20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="课程表" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="管理课程、查看本周安排" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" Header="显示周末" IsOn="{Binding ShowWeekends, Mode=TwoWay}"
                          VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Command="{Binding ImportCommand}" Style="{StaticResource AppButtonStyle}" ToolTipService.ToolTip="导入课程表（DOCX、XLS、XLSX、JSON、CSV、ICS）">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="ms-appx:///Assets/Icons/import.svg" Width="16" Height="16" />
                    <TextBlock Text="导入" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{Binding ExportJsonCommand}" Style="{StaticResource AppButtonStyle}" ToolTipService.ToolTip="导出 JSON">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="ms-appx:///Assets/Icons/export.svg" Width="16" Height="16" />
                    <TextBlock Text="JSON" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{Binding ExportCsvCommand}" Style="{StaticResource AppButtonStyle}" ToolTipService.ToolTip="导出 CSV">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="ms-appx:///Assets/Icons/export.svg" Width="16" Height="16" />
                    <TextBlock Text="CSV" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Command="{Binding ExportIcsCommand}" Style="{StaticResource AppButtonStyle}" ToolTipService.ToolTip="导出 ICS 日历">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="ms-appx:///Assets/Icons/export.svg" Width="16" Height="16" />
                    <TextBlock Text="ICS" />
                </StackPanel>
            </Button>
            <DropDownButton Grid.Column="4" HorizontalContentAlignment="Center"
                            ToolTipService.ToolTip="管理课程">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Edit" />
                    <TextBlock Text="课程编辑" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                        <ScrollViewer Width="340" MaxHeight="620"
                                      VerticalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="课程编辑" Style="{ThemeResource SubtitleTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding NewCourseCommand}"
                                            Style="{StaticResource AppButtonStyle}"
                                            ToolTipService.ToolTip="新增课程">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Add" />
                                            <TextBlock Text="新增" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ListView ItemsSource="{Binding Courses}"
                                          SelectedItem="{Binding SelectedCourse, Mode=TwoWay}"
                                          Height="126">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Location}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBox Header="课程名称"
                                         Text="{Binding CourseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="教师"
                                             Text="{Binding Teacher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1" Header="地点"
                                             Text="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <ComboBox Header="星期" SelectedIndex="{Binding WeekdayIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="周一" />
                                    <ComboBoxItem Content="周二" />
                                    <ComboBoxItem Content="周三" />
                                    <ComboBoxItem Content="周四" />
                                    <ComboBoxItem Content="周五" />
                                    <ComboBoxItem Content="周六" />
                                    <ComboBoxItem Content="周日" />
                                </ComboBox>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TimePicker Header="开始" ClockIdentifier="24HourClock"
                                                Time="{Binding StartTime, Mode=TwoWay}" />
                                    <TimePicker Grid.Column="1" Header="结束" ClockIdentifier="24HourClock"
                                                Time="{Binding EndTime, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox Header="起始周" Minimum="1" Maximum="52"
                                               SpinButtonPlacementMode="Inline"
                                               Value="{Binding FirstWeek, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1" Header="结束周" Minimum="1" Maximum="52"
                                               SpinButtonPlacementMode="Inline"
                                               Value="{Binding LastWeek, Mode=TwoWay}" />
                                </Grid>
                                <ComboBox Header="单双周" SelectedIndex="{Binding ParityIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="每周" />
                                    <ComboBoxItem Content="单周" />
                                    <ComboBoxItem Content="双周" />
                                </ComboBox>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Command="{Binding SaveCourseCommand}"
                                            Style="{StaticResource AppPrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Save" />
                                            <TextBlock Text="保存课程" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding DeleteCourseCommand}"
                                            Style="{StaticResource AppStopButtonStyle}"
                                            ToolTipService.ToolTip="删除选中课程">
                                        <Image Source="ms-appx:///Assets/Icons/trash.svg" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Grid.Column="6" Command="{Binding SelectTodayCommand}" Style="{StaticResource AppButtonStyle}"
                    HorizontalAlignment="Right" ToolTipService.ToolTip="定位到今天">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="ms-appx:///Assets/Icons/refresh.svg" Width="16" Height="16" />
                    <TextBlock Text="今天" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Width="162" Spacing="4">
                    <TextBlock Text="学期开始" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <DropDownButton x:Name="SemesterStartButton" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                        <TextBlock Text="{Binding SelectedSemesterStartOption.Text}"
                                   TextTrimming="CharacterEllipsis" />
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <ListView x:Name="SemesterStartList" Width="180" MaxHeight="240"
                                          ItemsSource="{Binding SemesterStartOptions}"
                                          SelectedItem="{Binding SelectedSemesterStartOption, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          IsItemClickEnabled="True"
                                          ItemClick="SemesterStartList_ItemClick"
                                          ScrollViewer.VerticalScrollMode="Enabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
                <CalendarDatePicker Grid.Column="1" Header="查看日期" Date="{Binding SelectedDate, Mode=TwoWay}" />
                <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding SelectedDayText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NextCourseText}" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,1,1">
                            <Grid Padding="4,4,4,3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="星期" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="节次" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Grid x:Name="WeekHeaderGrid" Grid.Column="1" />
                    </Grid>

                    <ScrollViewer x:Name="ScheduleScrollViewer" Grid.Row="1"
                                  HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                                  SizeChanged="ScheduleScrollViewer_SizeChanged">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Canvas x:Name="TimeAxisCanvas" Width="78" />
                            <Canvas x:Name="ScheduleCanvas" Grid.Column="1" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
