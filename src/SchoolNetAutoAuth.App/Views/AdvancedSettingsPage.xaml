<Page
    x:Name="PageRoot"
    x:Class="SchoolNetAutoAuth.App.Views.AdvancedSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <ScrollViewer x:Name="PageScroll" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  Padding="32,28,32,32">
        <StackPanel x:Name="PageContent" Spacing="20">

            <Grid Padding="0,0,0,16" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="运维" Style="{StaticResource AppPageEyebrowTextStyle}" />
                    <TextBlock Text="高级设置" Style="{StaticResource AppPageTitleTextStyle}" />
                    <TextBlock Text="重试策略、凭据、启动与诊断" Style="{StaticResource AppPageDescriptionTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{Binding SaveCommand}"
                        Style="{StaticResource AppPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                        <TextBlock Text="保存策略" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== 认证策略 ===== -->
            <Border Style="{StaticResource AppCardStyle}" Padding="0">
                <StackPanel>
                    <Grid MinHeight="48" Padding="16,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="认证策略" Style="{StaticResource AppSectionTitleTextStyle}" />
                            <TextBlock Text="失败后的重试节奏与单次认证超时" Style="{StaticResource AppCaptionTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <Grid Padding="16,14" ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="重试间隔（秒）" Style="{StaticResource AppSectionLabelTextStyle}" />
                            <NumberBox Value="{Binding RetryIntervalSeconds, Mode=TwoWay}" Minimum="1"
                                       SpinButtonPlacementMode="Inline" Style="{StaticResource AppNumberBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="最大重试次数" Style="{StaticResource AppSectionLabelTextStyle}" />
                            <NumberBox Value="{Binding MaximumAttempts, Mode=TwoWay}" Minimum="1"
                                       SpinButtonPlacementMode="Inline" Style="{StaticResource AppNumberBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="认证超时（秒）" Style="{StaticResource AppSectionLabelTextStyle}" />
                            <NumberBox Value="{Binding AuthenticationTimeoutSeconds, Mode=TwoWay}" Minimum="5"
                                       SpinButtonPlacementMode="Inline" Style="{StaticResource AppNumberBoxStyle}" />
                        </StackPanel>
                        <Rectangle Grid.Column="3" Style="{StaticResource AppVerticalDividerStyle}" />
                        <Border Grid.Column="4" Style="{StaticResource AppCardStyle}"
                                Background="{StaticResource AppPanelBrush}" Padding="16,10" VerticalAlignment="Center">
                            <ToggleSwitch Header="开机启动" IsOn="{Binding StartWithWindows, Mode=TwoWay}"
                                          OnContent="随系统启动" OffContent="手动启动"
                                          Style="{StaticResource AppToggleSwitchStyle}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 校园网凭据 ===== -->
            <Border Style="{StaticResource AppCardStyle}" Padding="0">
                <StackPanel>
                    <Grid MinHeight="48" Padding="16,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="校园网凭据" Style="{StaticResource AppSectionTitleTextStyle}" />
                            <TextBlock Text="写入 Windows 凭据管理器；Edge 内已保存的账号优先自动填充"
                                       Style="{StaticResource AppCaptionTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Padding="16,14" Spacing="14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="账号" Style="{StaticResource AppSectionLabelTextStyle}" />
                                <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource AppTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="密码" Style="{StaticResource AppSectionLabelTextStyle}" />
                                <PasswordBox Password="{Binding Password, Mode=TwoWay}" Style="{StaticResource AppPasswordBoxStyle}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding SaveCredentialCommand}" Style="{StaticResource AppSurfaceButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                    <TextBlock Text="保存凭据" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteCredentialCommand}" Style="{StaticResource AppDestructiveButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="删除凭据" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Edge 与诊断 ===== -->
            <Border Style="{StaticResource AppCardStyle}" Padding="0">
                <StackPanel>
                    <Grid MinHeight="48" Padding="16,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Edge 与诊断" Style="{StaticResource AppSectionTitleTextStyle}" />
                            <TextBlock Text="自动化浏览器使用独立配置，不影响日常 Edge"
                                       Style="{StaticResource AppCaptionTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Padding="16,14" Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Edge 配置目录" Style="{StaticResource AppSectionLabelTextStyle}" />
                            <TextBlock Text="{Binding EdgeProfilePath}" Style="{StaticResource AppMonoMutedTextStyle}" TextWrapping="Wrap" />
                            <Button Command="{Binding OpenEdgeProfileDirectoryCommand}" Style="{StaticResource AppButtonStyle}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE838;" FontSize="12" />
                                    <TextBlock Text="打开目录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Rectangle Style="{StaticResource AppDividerStyle}" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="运行日志" Style="{StaticResource AppSectionLabelTextStyle}" />
                            <TextBlock Text="{Binding LogPath}" Style="{StaticResource AppMonoMutedTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="最多 1 MiB，超限自动截断最早内容；不记录账号、密码、Cookie 与网页原文。"
                                       Style="{StaticResource AppMicroTextStyle}" MaxWidth="620" />
                            <Button Command="{Binding OpenLogDirectoryCommand}" Style="{StaticResource AppButtonStyle}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9F9;" FontSize="12" />
                                    <TextBlock Text="打开日志目录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
