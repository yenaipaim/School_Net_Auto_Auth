<Page
    x:Class="SchoolNetAutoAuth.App.Views.AdvancedSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" Padding="32" HorizontalAlignment="Left" Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Text="高级设置" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="重试、凭据、启动和诊断" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Spacing="14">
                <TextBlock Text="认证策略" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="16" RowSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <NumberBox Header="重试间隔（秒）" Value="{Binding RetryIntervalSeconds, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                    <NumberBox Grid.Column="1" Header="最大重试次数" Value="{Binding MaximumAttempts, Mode=TwoWay}" Minimum="1" SpinButtonPlacementMode="Inline" />
                    <NumberBox Grid.Row="1" Header="认证超时（秒）" Value="{Binding AuthenticationTimeoutSeconds, Mode=TwoWay}" Minimum="5" SpinButtonPlacementMode="Inline" />
                    <ToggleSwitch Grid.Row="1" Grid.Column="1" Header="开机启动" IsOn="{Binding StartWithWindows, Mode=TwoWay}" />
                </Grid>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Save" /><TextBlock Text="保存高级设置" /></StackPanel>
                </Button>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="14">
                <TextBlock Text="校园网凭据" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBox Header="账号" Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox Header="密码" Password="{Binding Password, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding SaveCredentialCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Save" /><TextBlock Text="保存凭据" /></StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteCredentialCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Delete" /><TextBlock Text="删除凭据" /></StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="14">
                <TextBlock Text="Edge 与诊断" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{Binding EdgeProfilePath}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Command="{Binding OpenEdgeProfileDirectoryCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Folder" /><TextBlock Text="打开 Edge 配置目录" /></StackPanel>
                </Button>
                <TextBlock Text="{Binding LogPath}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Command="{Binding OpenLogDirectoryCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Document" /><TextBlock Text="打开日志目录" /></StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
