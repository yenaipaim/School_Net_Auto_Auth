<Window
    x:Class="SchoolNetAutoAuth.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      外壳结构对齐 PVE-VDI：40px 自绘标题栏 + 可折叠侧栏（220 / 60）+ 透明内容区。
      零圆角、层次靠 1px 发际线、选中项靠 2px 品牌竖条，取值全部来自 App.xaml 的令牌。
      右上角 138 DIP 留给系统原生标题按钮（本投影里 AppWindowTitleBar 没有
      IsCaptionVisible，无法隐藏，所以只配色、不自己画按钮）。
    -->
    <Grid x:Name="Root" Background="{StaticResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 背景图：铺满整个窗口，侧栏与标题栏一起透出 ===== -->
        <Image x:Name="BackgroundImage" Grid.RowSpan="2" Grid.ColumnSpan="2"
               Stretch="UniformToFill" Opacity="0.45" IsHitTestVisible="False" />
        <!-- 压暗背景图，避免文字直接压在图片上失去可读性。 -->
        <Rectangle x:Name="BackgroundScrim" Grid.RowSpan="2" Grid.ColumnSpan="2"
                   Fill="{StaticResource AppBgBrush}"
                   Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- ===== 标题栏 ===== -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Grid.ColumnSpan="2"
              Background="{StaticResource AppCardBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Grid Width="18" Height="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="2" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0" Grid.Column="0" Stroke="{StaticResource AppBrandBrush}" StrokeThickness="1" />
                        <Rectangle Grid.Row="0" Grid.Column="2" Stroke="{StaticResource AppBorderStrongBrush}" StrokeThickness="1" />
                        <Rectangle Grid.Row="2" Grid.Column="0" Stroke="{StaticResource AppBorderStrongBrush}" StrokeThickness="1" />
                        <Rectangle Grid.Row="2" Grid.Column="2" Stroke="{StaticResource AppBrandBrush}" StrokeThickness="1" Opacity="0.6" />
                    </Grid>
                    <TextBlock Text="控制台" FontSize="12" FontWeight="SemiBold"
                               CharacterSpacing="80" Foreground="{StaticResource AppFgBrush}"
                               VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="14" Fill="{StaticResource AppBorderBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource AppMonoMutedTextStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="TitleActions" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" Margin="0,0,14,0">
                <Button x:Name="RefreshButton" AutomationProperties.Name="立即认证" Style="{StaticResource AppGhostButtonStyle}"
                        Height="30" BorderThickness="0" Padding="10,0" Click="Refresh_Click"
                        ToolTipService.ToolTip="立即认证">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" />
                        <TextBlock Text="立即认证" FontSize="11" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="14" Fill="{StaticResource AppBorderBrush}" VerticalAlignment="Center" />
                <StackPanel x:Name="TitleStatus" Orientation="Horizontal" Spacing="7"
                            VerticalAlignment="Center" Margin="8,0,6,0" MaxWidth="180">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource AppMutedFgBrush}" />
                    <TextBlock x:Name="TitleStatusText" Style="{StaticResource AppMonoMutedTextStyle}"
                               Text="正在初始化" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Rectangle Width="1" Height="14" Fill="{StaticResource AppBorderBrush}" VerticalAlignment="Center" />
                <Button x:Name="ThemeButton" AutomationProperties.Name="切换主题" Style="{StaticResource AppGhostButtonStyle}"
                        Width="34" Height="30" BorderThickness="0" Padding="0" Click="ThemeToggle_Click"
                        ToolTipService.ToolTip="切换深浅主题">
                    <FontIcon x:Name="ThemeGlyph" Glyph="&#xE708;" FontSize="12" />
                </Button>
            </StackPanel>

        </Grid>

        <!-- ===== 侧栏 ===== -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource AppCardBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="SidebarHeader">
                    <TextBlock x:Name="SidebarTitle" Tag="section" Text="导航" FontSize="10.5" FontWeight="Medium"
                               CharacterSpacing="80" Foreground="{StaticResource AppMutedFgBrush}"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                    <Button x:Name="CollapseButton" AutomationProperties.Name="折叠侧栏" Style="{StaticResource AppIconButtonStyle}"
                            Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0" Click="Collapse_Click" ToolTipService.ToolTip="收起侧边栏">
                        <FontIcon x:Name="CollapseGlyph" Glyph="&#xE76B;" FontSize="11" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel" Margin="8,12,8,16" Spacing="20">
                        <StackPanel Spacing="1">
                            <TextBlock Tag="section" Text="运行状态" Style="{StaticResource AppSectionLabelTextStyle}"
                                       FontSize="11" Margin="16,0,0,6" />
                            <RadioButton x:Name="StatusNav" AutomationProperties.AutomationId="nav-status" AutomationProperties.Name="状态" Tag="status" GroupName="AppNav"
                                         Style="{StaticResource AppNavItemStyle}" Background="Transparent"
                                         Checked="NavItem_Checked">
                                <Grid Tag="nav" Width="196" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                                    <TextBlock Grid.Column="1" Tag="label" Text="状态" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>
                            <RadioButton AutomationProperties.AutomationId="nav-recording" AutomationProperties.Name="认证流程" Tag="recording" GroupName="AppNav"
                                         Style="{StaticResource AppNavItemStyle}" Background="Transparent"
                                         Checked="NavItem_Checked">
                                <Grid Tag="nav" Width="196" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE768;" FontSize="15" />
                                    <TextBlock Grid.Column="1" Tag="label" Text="认证流程" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Spacing="1">
                            <TextBlock Tag="section" Text="网络" Style="{StaticResource AppSectionLabelTextStyle}"
                                       FontSize="11" Margin="16,0,0,6" />
                            <RadioButton AutomationProperties.AutomationId="nav-network" AutomationProperties.Name="网络设置" Tag="network" GroupName="AppNav"
                                         Style="{StaticResource AppNavItemStyle}" Background="Transparent"
                                         Checked="NavItem_Checked">
                                <Grid Tag="nav" Width="196" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE774;" FontSize="15" />
                                    <TextBlock Grid.Column="1" Tag="label" Text="网络设置" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>
                            <RadioButton AutomationProperties.AutomationId="nav-advanced" AutomationProperties.Name="高级设置" Tag="advanced" GroupName="AppNav"
                                         Style="{StaticResource AppNavItemStyle}" Background="Transparent"
                                         Checked="NavItem_Checked">
                                <Grid Tag="nav" Width="196" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                                    <TextBlock Grid.Column="1" Tag="label" Text="高级设置" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Spacing="1">
                            <TextBlock Tag="section" Text="工具" Style="{StaticResource AppSectionLabelTextStyle}"
                                       FontSize="11" Margin="16,0,0,6" />
                            <RadioButton AutomationProperties.AutomationId="nav-schedule" AutomationProperties.Name="课程表" Tag="schedule" GroupName="AppNav"
                                         Style="{StaticResource AppNavItemStyle}" Background="Transparent"
                                         Checked="NavItem_Checked">
                                <Grid Tag="nav" Width="196" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE787;" FontSize="15" />
                                    <TextBlock Grid.Column="1" Tag="label" Text="课程表" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Spacing="1">
                            <TextBlock Tag="section" Text="外观" Style="{StaticResource AppSectionLabelTextStyle}"
                                       FontSize="11" Margin="16,0,0,6" />
                            <RadioButton AutomationProperties.AutomationId="nav-general" AutomationProperties.Name="通用设置" Tag="general" GroupName="AppNav"
                                         Style="{StaticResource AppNavItemStyle}" Background="Transparent"
                                         Checked="NavItem_Checked">
                                <Grid Tag="nav" Width="196" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="15" />
                                    <TextBlock Grid.Column="1" Tag="label" Text="通用设置" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== 内容区：背景图在最底，页面透明覆盖其上 ===== -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Frame x:Name="ContentFrame" Background="Transparent" />
        </Grid>
    </Grid>
</Window>
