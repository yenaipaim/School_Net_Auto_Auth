<Page
    x:Class="SchoolNetAutoAuth.App.Views.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <ScrollViewer VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="820" Padding="32" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="状态" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="当前网络与认证运行情况" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Row="1" Margin="0,24,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="20">
                <Grid RowSpacing="18" ColumnSpacing="28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="当前 Wi-Fi" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding WifiName}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="联网状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ConnectivityText}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Text="认证状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding AuthenticationStateText}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <TextBlock Text="最近结果" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding LastAuthenticationResult}" TextWrapping="Wrap" MaxWidth="240" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,24,0,0" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Command="{Binding AuthenticateCommand}" Style="{StaticResource AccentButtonStyle}" Padding="18,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="立即认证" />
                    </StackPanel>
                </Button>
                <ToggleSwitch Grid.Column="1" Header="自动认证" IsOn="{Binding AutomaticAuthenticationEnabled, Mode=TwoWay}" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
