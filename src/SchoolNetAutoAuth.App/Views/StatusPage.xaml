<Page
    x:Name="PageRoot"
    x:Class="SchoolNetAutoAuth.App.Views.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <!-- 页面本身透明，让背景图透出；层次全部由卡片发际线承担。 -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- 宽度显式绑到视口：ScrollViewer 不会把内容约束到视口宽，否则卡片会向右溢出。 -->
        <StackPanel x:Name="PageContent" HorizontalAlignment="Left" MaxWidth="800" Padding="32,28,32,32" Spacing="20">

            <!-- ===== 页头：eyebrow + 大标题 + 描述 + 右侧动作 ===== -->
            <Grid Padding="0,0,0,16" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="运行状态" Style="{StaticResource AppPageEyebrowTextStyle}" />
                    <TextBlock Text="状态" Style="{StaticResource AppPageTitleTextStyle}" />
                    <TextBlock Text="当前网络与认证运行情况" Style="{StaticResource AppPageDescriptionTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Bottom"
                        Command="{Binding AuthenticateCommand}" Style="{StaticResource AppPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                        <TextBlock Text="立即认证" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== 指标卡：12px 标签 + 等宽读数 + 语义色 ===== -->
            <Grid RowSpacing="12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel>
                        <TextBlock Text="当前 Wi-Fi" Style="{StaticResource AppSectionLabelTextStyle}" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding WifiName}"
                                   Style="{StaticResource AppMetricTextStyle}" FontSize="17"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                    <StackPanel>
                        <TextBlock Text="联网状态" Style="{StaticResource AppSectionLabelTextStyle}" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding ConnectivityText}"
                                   Style="{StaticResource AppMetricTextStyle}" FontSize="17"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding ConnectivityBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource AppCardStyle}">
                    <StackPanel>
                        <TextBlock Text="认证状态" Style="{StaticResource AppSectionLabelTextStyle}" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding AuthenticationStateText}"
                                   Style="{StaticResource AppMetricTextStyle}" FontSize="17"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding StateBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== 最近结果面板 ===== -->
            <Border Style="{StaticResource AppCardStyle}" Padding="0">
                <StackPanel>
                    <Grid MinHeight="48" Padding="16,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="最近一次认证结果" Style="{StaticResource AppSectionTitleTextStyle}" />
                            <TextBlock Text="认证期间的网页提示会在此显示，敏感内容已脱敏"
                                       Style="{StaticResource AppCaptionTextStyle}" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                      OnContent="自动认证已开启" OffContent="自动认证已暂停"
                                      IsOn="{Binding AutomaticAuthenticationEnabled, Mode=TwoWay}"
                                      Style="{StaticResource AppToggleSwitchStyle}" />
                    </Grid>
                    <StackPanel Padding="16,14" Spacing="14">
                        <TextBlock Text="{Binding LastAuthenticationResult}" Style="{StaticResource AppBodyTextStyle}"
                                   TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="认证入口" Style="{StaticResource AppCaptionTextStyle}" FontSize="11" />
                                <TextBlock Text="{Binding PortalUriText}" Style="{StaticResource AppMonoTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="联网检测地址" Style="{StaticResource AppCaptionTextStyle}" FontSize="11" />
                                <TextBlock Text="{Binding ProbeUriText}" Style="{StaticResource AppMonoTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppCardStyle}" Background="{StaticResource AppPanelBrush}" Padding="16,12">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource AppInfoBrush}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Style="{StaticResource AppCaptionTextStyle}" MaxWidth="640"
                               Text="网页要求手机验证或提示在线设备达到上限时，程序会先复查联网状态；未联网则保留 Edge 页面并在 5 分钟后自动重试，点「立即认证」可跳过等待。" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
