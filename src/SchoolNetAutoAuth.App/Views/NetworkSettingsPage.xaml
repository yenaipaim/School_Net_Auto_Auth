<Page
    x:Name="PageRoot"
    x:Class="SchoolNetAutoAuth.App.Views.NetworkSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SchoolNetAutoAuth.App.Converters"
    Background="Transparent"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
        <conv:SignalBarsConverter x:Key="SignalBars" />
        <conv:WifiSecurityLabelConverter x:Key="SecurityLabel" />
        <conv:WifiSecurityBrushConverter x:Key="SecurityBrush" />
    </Page.Resources>
    <ScrollViewer x:Name="PageScroll" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  Padding="32,28,32,32">
        <StackPanel x:Name="PageContent" Spacing="20">

            <Grid Padding="0,0,0,16" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="网络" Style="{StaticResource AppPageEyebrowTextStyle}" />
                    <TextBlock Text="网络设置" Style="{StaticResource AppPageTitleTextStyle}" />
                    <TextBlock Text="配置目标网络、认证入口和检测频率" Style="{StaticResource AppPageDescriptionTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{Binding SaveCommand}"
                        Style="{StaticResource AppPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="12" />
                        <TextBlock Text="保存设置" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== 连接目标 ===== -->
            <Border Style="{StaticResource AppCardStyle}" Padding="0">
                <StackPanel>
                    <Grid MinHeight="48" Padding="16,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="连接目标" Style="{StaticResource AppSectionTitleTextStyle}" />
                            <TextBlock Text="只有连上这个 Wi-Fi 才会触发认证；列表为空时可直接手输" Style="{StaticResource AppCaptionTextStyle}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center"
                                Command="{Binding ScanCommand}"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                                Style="{StaticResource AppSmallButtonStyle}"
                                Content="重新扫描" />
                    </Grid>
                    <StackPanel Padding="16,14" Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="目标 Wi-Fi" Style="{StaticResource AppSectionLabelTextStyle}" />
                            <ComboBox IsEditable="True"
                                      Text="{Binding TargetSsid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding NearbyNetworks}"
                                      PlaceholderText="例如 NSU-SDN"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="32" ColumnSpacing="8" MinWidth="300">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 4 格信号柱：底对齐，高度 4 / 7 / 10 / 13 -->
                                            <Grid Width="20" Height="13" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2" />
                                                    <ColumnDefinition Width="2" />
                                                    <ColumnDefinition Width="2" />
                                                    <ColumnDefinition Width="2" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="2" Height="4" VerticalAlignment="Bottom"
                                                           Fill="{StaticResource AppFgBrush}"
                                                           Visibility="{Binding SignalQuality, Converter={StaticResource SignalBars}, ConverterParameter=0}" />
                                                <Rectangle Grid.Column="1" Width="2" Height="7" VerticalAlignment="Bottom"
                                                           Fill="{StaticResource AppFgBrush}"
                                                           Visibility="{Binding SignalQuality, Converter={StaticResource SignalBars}, ConverterParameter=1}" />
                                                <Rectangle Grid.Column="2" Width="2" Height="10" VerticalAlignment="Bottom"
                                                           Fill="{StaticResource AppFgBrush}"
                                                           Visibility="{Binding SignalQuality, Converter={StaticResource SignalBars}, ConverterParameter=2}" />
                                                <Rectangle Grid.Column="3" Width="2" Height="13" VerticalAlignment="Bottom"
                                                           Fill="{StaticResource AppFgBrush}"
                                                           Visibility="{Binding SignalQuality, Converter={StaticResource SignalBars}, ConverterParameter=3}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Ssid}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource AppFgBrush}" />
                                            <Border Grid.Column="2" VerticalAlignment="Center" Padding="5,1"
                                                    CornerRadius="0" BorderThickness="1"
                                                    BorderBrush="{StaticResource AppBrandBrush}"
                                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="已连接" FontSize="11"
                                                           Foreground="{StaticResource AppBrandBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding IsSecured, Converter={StaticResource SecurityLabel}}"
                                                       FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{Binding IsSecured, Converter={StaticResource SecurityBrush}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource AppCaptionTextStyle}" FontSize="12" />
                        </StackPanel>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="认证地址" Style="{StaticResource AppSectionLabelTextStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding PortalUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             PlaceholderText="例如 http://2.2.2.2"
                                             FontFamily="{StaticResource AppFontMono}" FontSize="12" />
                                    <Button Grid.Column="1" Content="自动检测"
                                            Command="{Binding DetectPortalCommand}"
                                            IsEnabled="{Binding IsDetectingPortal, Converter={StaticResource InverseBool}}"
                                            Style="{StaticResource AppSmallButtonStyle}" />
                                </Grid>
                                <TextBlock Text="{Binding PortalHint}" Style="{StaticResource AppCaptionTextStyle}" FontSize="12"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding PortalHint, Converter={StaticResource NotEmptyToVisibility}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="联网检测地址（必须 HTTPS）" Style="{StaticResource AppSectionLabelTextStyle}" />
                                <TextBox Text="{Binding ProbeUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource AppTextBoxStyle}"
                                         FontFamily="{StaticResource AppFontMono}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 检测节奏 ===== -->
            <Border Style="{StaticResource AppCardStyle}" Padding="0">
                <StackPanel>
                    <Grid MinHeight="48" Padding="16,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="检测节奏" Style="{StaticResource AppSectionTitleTextStyle}" />
                            <TextBlock Text="未联网时的轮询间隔，联网后固定 30 分钟" Style="{StaticResource AppCaptionTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <Grid Padding="16,14" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="未联网检测间隔（秒）" Style="{StaticResource AppSectionLabelTextStyle}" />
                            <NumberBox Value="{Binding NetworkCheckIntervalSeconds, Mode=TwoWay}"
                                       Minimum="3" Maximum="3600" SpinButtonPlacementMode="Inline"
                                       Style="{StaticResource AppNumberBoxStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource AppCardStyle}"
                                Background="{StaticResource AppPanelBrush}" Padding="14,12" VerticalAlignment="Center">
                            <ToggleSwitch Header="自动认证" IsOn="{Binding AutomaticAuthenticationEnabled, Mode=TwoWay}"
                                          OnContent="按间隔自动重试" OffContent="仅手动认证"
                                          Style="{StaticResource AppToggleSwitchStyle}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
