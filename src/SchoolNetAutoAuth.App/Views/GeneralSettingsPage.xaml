<Page
    x:Name="PageRoot"
    x:Class="SchoolNetAutoAuth.App.Views.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SchoolNetAutoAuth.App.Converters"
    Background="Transparent"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:EqualToColorConverter x:Key="EqualTo" />
        <Style x:Key="AppSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <!-- Button 默认模板会把内容居中，纯 Rectangle 内容会量出 0 尺寸而塌陷。 -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>
    <ScrollViewer x:Name="PageScroll" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  Padding="32,28,32,32">
        <StackPanel x:Name="PageContent" Spacing="20">

            <!-- ===== 页头 ===== -->
            <Grid Padding="0,0,0,16" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="6">
                    <TextBlock Text="通用" Style="{StaticResource AppPageEyebrowTextStyle}" />
                    <TextBlock Text="通用设置" Style="{StaticResource AppPageTitleTextStyle}" />
                    <TextBlock Text="版本、外观、背景图像与交流群" Style="{StaticResource AppPageDescriptionTextStyle}" />
                </StackPanel>
            </Grid>

            <!-- ===== 界面主题 ===== -->
            <Border Style="{StaticResource AppCardStyle}" Padding="0">
                <StackPanel>
                    <Grid MinHeight="48" Padding="16,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="界面主题" Style="{StaticResource AppSectionTitleTextStyle}" />
                            <TextBlock Text="深色为默认，浅色更接近原生 Windows 观感" Style="{StaticResource AppCaptionTextStyle}" FontSize="12" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding ToggleThemeCommand}" Style="{StaticResource AppSurfaceButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{Binding ThemeGlyph}" FontSize="13" />
                                <TextBlock Text="{Binding ThemeLabel}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Padding="16,14" Spacing="14">
                        <TextBlock Text="强调色" Style="{StaticResource AppSectionLabelTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AppSwatchButtonStyle}" Command="{Binding SelectAccentCommand}" CommandParameter="#0078D4"
                                    ToolTipService.ToolTip="Windows 蓝">
                                <Grid>
                                    <Rectangle Fill="#0078D4" />
                                    <Rectangle Stroke="{StaticResource AppFgBrush}" StrokeThickness="1.5" Margin="-4"
                                               Visibility="{Binding AccentColor, Converter={StaticResource EqualTo}, ConverterParameter=#0078D4}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource AppSwatchButtonStyle}" Command="{Binding SelectAccentCommand}" CommandParameter="#3B82F6"
                                    ToolTipService.ToolTip="信号蓝">
                                <Grid>
                                    <Rectangle Fill="#3B82F6" />
                                    <Rectangle Stroke="{StaticResource AppFgBrush}" StrokeThickness="1.5" Margin="-4"
                                               Visibility="{Binding AccentColor, Converter={StaticResource EqualTo}, ConverterParameter=#3B82F6}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource AppSwatchButtonStyle}" Command="{Binding SelectAccentCommand}" CommandParameter="#0D9488"
                                    ToolTipService.ToolTip="青绿">
                                <Grid>
                                    <Rectangle Fill="#0D9488" />
                                    <Rectangle Stroke="{StaticResource AppFgBrush}" StrokeThickness="1.5" Margin="-4"
                                               Visibility="{Binding AccentColor, Converter={StaticResource EqualTo}, ConverterParameter=#0D9488}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource AppSwatchButtonStyle}" Command="{Binding SelectAccentCommand}" CommandParameter="#8B5CF6"
                                    ToolTipService.ToolTip="紫罗兰">
                                <Grid>
                                    <Rectangle Fill="#8B5CF6" />
                                    <Rectangle Stroke="{StaticResource AppFgBrush}" StrokeThickness="1.5" Margin="-4"
                                               Visibility="{Binding AccentColor, Converter={StaticResource EqualTo}, ConverterParameter=#8B5CF6}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource AppSwatchButtonStyle}" Command="{Binding SelectAccentCommand}" CommandParameter="#E11D48"
                                    ToolTipService.ToolTip="玫红">
                                <Grid>
                                    <Rectangle Fill="#E11D48" />
                                    <Rectangle Stroke="{StaticResource AppFgBrush}" StrokeThickness="1.5" Margin="-4"
                                               Visibility="{Binding AccentColor, Converter={StaticResource EqualTo}, ConverterParameter=#E11D48}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource AppSwatchButtonStyle}" Command="{Binding SelectAccentCommand}" CommandParameter="#F26B1D"
                                    ToolTipService.ToolTip="工业橙">
                                <Grid>
                                    <Rectangle Fill="#F26B1D" />
                                    <Rectangle Stroke="{StaticResource AppFgBrush}" StrokeThickness="1.5" Margin="-4"
                                               Visibility="{Binding AccentColor, Converter={StaticResource EqualTo}, ConverterParameter=#F26B1D}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding AccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AppTextBoxStyle}"
                                     FontFamily="{StaticResource AppFontMono}" FontSize="12" />
                            <Border Grid.Column="1" Width="36" Height="36" Padding="2"
                                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                    Background="{StaticResource AppCardBrush}">
                                <Rectangle Fill="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="取值需为 #RGB 或 #RRGGBB；浅色模式会自动加深以保证文字对比度。"
                                   Style="{StaticResource AppMicroTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 界面字体 ===== -->
            <Border Style="{StaticResource AppCardStyle}" Padding="0">
                <StackPanel>
                    <Grid MinHeight="48" Padding="16,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="界面字体" Style="{StaticResource AppSectionTitleTextStyle}" />
                            <TextBlock Text="留空则使用系统字体栈" Style="{StaticResource AppCaptionTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Padding="16,14" Spacing="12">
                        <ComboBox ItemsSource="{Binding FontOptions}" SelectedValuePath="Value"
                                  SelectedValue="{Binding FontSelection, Mode=TwoWay}"
                                  Style="{StaticResource AppComboBoxStyle}" HorizontalAlignment="Left" Width="200">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox PlaceholderText="已安装的字体族名称，例如 HarmonyOS Sans SC"
                                 Text="{Binding CustomFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBoxStyle}"
                                 IsEnabled="{Binding IsCustomFontEnabled}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 背景图像 ===== -->
            <Border Style="{StaticResource AppCardStyle}" Padding="0">
                <StackPanel>
                    <Grid MinHeight="48" Padding="16,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="背景图像" Style="{StaticResource AppSectionTitleTextStyle}" />
                            <TextBlock Text="{Binding BackgroundImageText}" Style="{StaticResource AppCaptionTextStyle}"
                                       FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="620" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Padding="16,14" Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider Header="不透明度（数值越高背景图越明显）" Minimum="0" Maximum="100" StepFrequency="1"
                                    Value="{Binding BackgroundImageOpacityPercent, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{Binding BackgroundImageOpacityText}"
                                       Style="{StaticResource AppMonoTextStyle}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding ChooseBackgroundImageCommand}" Style="{StaticResource AppSurfaceButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                    <TextBlock Text="选择图像" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClearBackgroundImageCommand}" Style="{StaticResource AppButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    <TextBlock Text="清除" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 版本更新 ===== -->
            <Border Style="{StaticResource AppCardStyle}" Padding="0">
                <Grid MinHeight="56" Padding="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="当前版本" Style="{StaticResource AppSectionLabelTextStyle}" />
                        <TextBlock Text="{Binding CurrentVersion}" Style="{StaticResource AppMetricTextStyle}" FontSize="18" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center"
                            Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding CanCheckUpdates}"
                            Style="{StaticResource AppSurfaceButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE895;" FontSize="12" />
                            <TextBlock Text="检查更新" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== 作者与交流群 ===== -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="作者" Style="{StaticResource AppSectionLabelTextStyle}" />
                        <TextBlock Text="{Binding Author}" Style="{StaticResource AppMetricTextStyle}" FontSize="18" />
                        <HyperlinkButton Content="{Binding RepositoryUri}" NavigateUri="{Binding RepositoryUri}" Padding="0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="交流群" Style="{StaticResource AppSectionLabelTextStyle}" />
                        <TextBlock Text="{Binding GroupNumber}" Style="{StaticResource AppMetricTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource AppCardStyle}" HorizontalAlignment="Left" Padding="12">
                <Image Source="ms-appx:///Assets/QQ.png" Width="240" Stretch="Uniform" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
