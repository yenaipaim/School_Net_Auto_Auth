<Window
    x:Class="SchoolNetAutoAuth.App.Notifications.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="6" Padding="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="0,0,44,0" TextWrapping="NoWrap" />
            <Button x:Name="CloseButton" Grid.Column="1" Click="Close_Click" ToolTipService.ToolTip="关闭通知"
                    Width="36" Height="36" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="8,-8,-8,0" Background="Transparent" BorderThickness="0">
                <SymbolIcon Symbol="Cancel" />
            </Button>
            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
