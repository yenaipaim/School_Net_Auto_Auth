<Window
    x:Class="SchoolNetAutoAuth.App.Notifications.NotificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 桌面通知卡片：零圆角 + 左侧语义色竖条，与主窗口同一套令牌。 -->
    <!-- ContentControl 作根：它同时支持 RequestedTheme 与 FontFamily（继承给所有文本）。
         注意 ContentControl 的默认模板不绘制 Background，卡片底色必须放在 Border 上。 -->
    <!-- 内容必须拉伸填满窗口：默认左对齐时，短文本会让卡片只占左侧一块，
         右边露出未绘制的黑色区域。 -->
    <ContentControl x:Name="Root" Padding="0" FontSize="12"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Border x:Name="Card" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="{StaticResource AppCardBrush}"
                BorderBrush="{StaticResource AppBorderStrongBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 语义色竖条：显式宽度，避免被 Grid 拉伸成色块 -->
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="AccentBar" Grid.Column="0" Background="{StaticResource AppBrandBrush}" />

                <Grid Grid.Column="1" Padding="12,8,8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText" Grid.Row="0" Grid.Column="0"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource AppFgBrush}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />

                    <!-- 关闭按钮固定在右上角 -->
                    <Button x:Name="CloseButton" Grid.Row="0" Grid.Column="1" Click="Close_Click"
                            AutomationProperties.AutomationId="NotificationCloseButton"
                            AutomationProperties.Name="关闭通知"
                            ToolTipService.ToolTip="关闭通知"
                            Width="22" Height="22" Padding="0" Margin="8,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0" CornerRadius="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <FontIcon Glyph="&#xE8BB;" FontSize="9" Foreground="{StaticResource AppMutedFgBrush}" />
                    </Button>

                    <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                  VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                                   FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource AppMutedFgBrush}" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </ContentControl>
</Window>