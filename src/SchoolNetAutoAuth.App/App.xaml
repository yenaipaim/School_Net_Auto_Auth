<Application x:Class="SchoolNetAutoAuth.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!--
              ===== 设计令牌层（对齐 PVE-VDI 的 index.css @theme inline） =====
              规则来源：
              1. 零圆角：PVE-VDI 用 `border-radius: 0 !important` 全局压平，这里对应 CornerRadius=0。
              2. 层次靠 1px 发际线边框 + 色阶，不靠阴影（弹窗/浮层除外）。
              3. 字号固定档位：28 / 14 / 13 / 12 / 11 / 10.5；数字一律等宽 + tabular。
              4. 语义色用「透明底 + 同色描边 + 同色文字」调制，而不是另挑一套颜色。
              笔刷实例由 ThemeService 在运行时原地改 Color（等价于 PVE-VDI 里
              root.style.setProperty 覆盖 brand 变量），因此所有引用同一实例的地方会同步刷新。
            -->
            <FontFamily x:Key="AppFontSans">Segoe UI Variable, Segoe UI, Microsoft YaHei UI, PingFang SC</FontFamily>
            <FontFamily x:Key="AppFontMono">Cascadia Code, Consolas, JetBrains Mono</FontFamily>

            <SolidColorBrush x:Key="AppBgBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AppTransparentBrush" Color="#00000000" />
            <SolidColorBrush x:Key="AppFgBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#252526" />
            <SolidColorBrush x:Key="AppPanelBrush" Color="#2B2B2D" />
            <SolidColorBrush x:Key="AppPanelHoverBrush" Color="#323234" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#2E2E31" />
            <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#3A3A3D" />
            <SolidColorBrush x:Key="AppPopoverBrush" Color="#2B2B2D" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="#333336" />
            <SolidColorBrush x:Key="AppMutedFgBrush" Color="#B8B8B8" />
            <SolidColorBrush x:Key="AppPlaceholderBrush" Color="#99B8B8B8" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#3F3F46" />
            <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#52525B" />
            <SolidColorBrush x:Key="AppInputBrush" Color="#4A4A50" />
            <SolidColorBrush x:Key="AppPrimaryBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="AppPrimaryFgBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AppSecondaryBrush" Color="#333336" />
            <SolidColorBrush x:Key="AppSecondaryFgBrush" Color="#E8E8E8" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#3A3A3D" />
            <SolidColorBrush x:Key="AppAccentFgBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="AppDestructiveBrush" Color="#F14C4C" />
            <SolidColorBrush x:Key="AppDestructiveFgBrush" Color="#FFF7F7" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#4EC9B0" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#D7BA7D" />
            <SolidColorBrush x:Key="AppInfoBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="AppBrandBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AppBrandFgBrush" Color="#FFFAF5" />
            <SolidColorBrush x:Key="AppRingBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AppOverlayBrush" Color="#C80C0C0C" />
            <SolidColorBrush x:Key="AppGridLineBrush" Color="#0BFFFFFF" />

            <!-- 语义色的低透明版本，对应 PVE-VDI 的 bg-success/10、border-success/25 写法。 -->
            <SolidColorBrush x:Key="AppSuccessSoftBgBrush" Color="#1A4EC9B0" />
            <SolidColorBrush x:Key="AppSuccessSoftBorderBrush" Color="#404EC9B0" />
            <SolidColorBrush x:Key="AppWarningSoftBgBrush" Color="#1AD7BA7D" />
            <SolidColorBrush x:Key="AppWarningSoftBorderBrush" Color="#4DD7BA7D" />
            <SolidColorBrush x:Key="AppDestructiveSoftBgBrush" Color="#1AF14C4C" />
            <SolidColorBrush x:Key="AppDestructiveSoftBorderBrush" Color="#73F14C4C" />
            <SolidColorBrush x:Key="AppInfoSoftBgBrush" Color="#1A4CC2FF" />
            <SolidColorBrush x:Key="AppInfoSoftBorderBrush" Color="#4D4CC2FF" />
            <SolidColorBrush x:Key="AppBrandSoftBgBrush" Color="#1A0078D4" />
            <SolidColorBrush x:Key="AppBrandSoftBorderBrush" Color="#660078D4" />

            <!--
              ===== WinUI 主题键别名 =====
              把控件模板内部引用的 ThemeResource 键指向我们的笔刷实例，
              这样既接管了原生控件配色，又保留实例化共享（改 Color 即全局生效）。
              这里只列 generic.xaml 中已确认为 SolidColorBrush 的键：
              别名一个 Double/CornerRadius 键会在运行时抛类型异常，
              而 themeresources.xaml 里的键（TextControl* / Slider* / ToolTip* 等）
              随运行时版本变化，所以改由 App*Style 的显式 Setter 覆盖。
            -->
            <StaticResource x:Key="TextFillColorPrimaryBrush" ResourceKey="AppFgBrush" />
            <StaticResource x:Key="TextFillColorSecondaryBrush" ResourceKey="AppMutedFgBrush" />
            <StaticResource x:Key="TextFillColorTertiaryBrush" ResourceKey="AppPlaceholderBrush" />
            <StaticResource x:Key="TextFillColorDisabledBrush" ResourceKey="AppPlaceholderBrush" />
            <StaticResource x:Key="SolidBackgroundFillColorBaseBrush" ResourceKey="AppBgBrush" />
            <StaticResource x:Key="SolidBackgroundFillColorSecondaryBrush" ResourceKey="AppPanelBrush" />
            <StaticResource x:Key="SolidBackgroundFillColorTertiaryBrush" ResourceKey="AppSurfaceBrush" />
            <StaticResource x:Key="SolidBackgroundFillColorQuarternaryBrush" ResourceKey="AppPanelHoverBrush" />
            <StaticResource x:Key="LayerFillColorDefaultBrush" ResourceKey="AppCardBrush" />
            <StaticResource x:Key="LayerFillColorAltBrush" ResourceKey="AppPopoverBrush" />
            <StaticResource x:Key="CardBackgroundFillColorDefaultBrush" ResourceKey="AppCardBrush" />
            <StaticResource x:Key="CardBackgroundFillColorSecondaryBrush" ResourceKey="AppPanelBrush" />
            <StaticResource x:Key="CardStrokeColorDefaultBrush" ResourceKey="AppBorderBrush" />
            <StaticResource x:Key="CardStrokeColorDefaultSolidBrush" ResourceKey="AppBorderBrush" />
            <StaticResource x:Key="DividerStrokeColorDefaultBrush" ResourceKey="AppBorderBrush" />
            <StaticResource x:Key="ControlFillColorDefaultBrush" ResourceKey="AppCardBrush" />
            <StaticResource x:Key="ControlFillColorSecondaryBrush" ResourceKey="AppSurfaceBrush" />
            <StaticResource x:Key="ControlFillColorTertiaryBrush" ResourceKey="AppMutedBrush" />
            <StaticResource x:Key="ControlFillColorDisabledBrush" ResourceKey="AppMutedBrush" />
            <StaticResource x:Key="ControlStrokeColorDefaultBrush" ResourceKey="AppBorderBrush" />
            <StaticResource x:Key="ControlStrokeColorSecondaryBrush" ResourceKey="AppBorderStrongBrush" />
            <StaticResource x:Key="ControlAltFillColorSecondaryBrush" ResourceKey="AppPanelHoverBrush" />
            <StaticResource x:Key="ControlAltFillColorTertiaryBrush" ResourceKey="AppSurfaceHoverBrush" />
            <StaticResource x:Key="SubtleFillColorSecondaryBrush" ResourceKey="AppAccentBrush" />
            <StaticResource x:Key="SubtleFillColorTertiaryBrush" ResourceKey="AppPanelHoverBrush" />
            <StaticResource x:Key="AccentFillColorDefaultBrush" ResourceKey="AppBrandBrush" />
            <StaticResource x:Key="AccentFillColorSecondaryBrush" ResourceKey="AppBrandSoftBgBrush" />
            <StaticResource x:Key="AccentFillColorTertiaryBrush" ResourceKey="AppBrandSoftBgBrush" />
            <StaticResource x:Key="SystemFillColorSuccessBrush" ResourceKey="AppSuccessBrush" />
            <StaticResource x:Key="SystemFillColorCautionBrush" ResourceKey="AppWarningBrush" />
            <StaticResource x:Key="SystemFillColorCriticalBrush" ResourceKey="AppDestructiveBrush" />
            <StaticResource x:Key="SystemFillColorNeutralBrush" ResourceKey="AppMutedFgBrush" />
            <StaticResource x:Key="SystemFillColorAttentionBrush" ResourceKey="AppInfoBrush" />
            <StaticResource x:Key="ButtonBackground" ResourceKey="AppSurfaceBrush" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AppSurfaceHoverBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AppPanelHoverBrush" />
            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="AppMutedBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AppAccentBrush" />
            <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="AppPanelHoverBrush" />
            <StaticResource x:Key="ListViewItemForeground" ResourceKey="AppFgBrush" />
            <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="AppFgBrush" />

            <!-- ===== 排版样式 ===== -->
            <Style x:Key="AppPageEyebrowTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="CharacterSpacing" Value="20" />
                <Setter Property="Foreground" Value="{StaticResource AppMutedFgBrush}" />
            </Style>
            <Style x:Key="AppPageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-20" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
            </Style>
            <Style x:Key="AppPageDescriptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource AppMutedFgBrush}" />
            </Style>
            <Style x:Key="AppSectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="CharacterSpacing" Value="-14" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
            </Style>
            <Style x:Key="AppSectionLabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource AppMutedFgBrush}" />
            </Style>
            <Style x:Key="AppBodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
            </Style>
            <Style x:Key="AppCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="19" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource AppMutedFgBrush}" />
            </Style>
            <Style x:Key="AppMicroTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource AppMutedFgBrush}" />
            </Style>
            <Style x:Key="AppMonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontMono}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
            </Style>
            <Style x:Key="AppMonoMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppMonoTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppMutedFgBrush}" />
            </Style>
            <Style x:Key="AppMetricTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontMono}" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="CharacterSpacing" Value="-30" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
            </Style>
            <Style x:Key="AppSuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppBodyTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}" />
            </Style>
            <Style x:Key="AppWarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppBodyTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppWarningBrush}" />
            </Style>
            <Style x:Key="AppDestructiveTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppBodyTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppDestructiveBrush}" />
            </Style>
            <Style x:Key="AppInfoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppBodyTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppInfoBrush}" />
            </Style>
            <Style x:Key="AppBrandTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppBodyTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppBrandBrush}" />
            </Style>

            <!-- ===== 结构样式 ===== -->
            <Style x:Key="AppCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AppCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <Style x:Key="AppDividerStyle" TargetType="Rectangle">
                <Setter Property="Height" Value="1" />
                <Setter Property="Fill" Value="{StaticResource AppBorderBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="AppVerticalDividerStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Fill" Value="{StaticResource AppBorderBrush}" />
            </Style>

            <!-- ===== 按钮：8 个 variant 对应 PVE-VDI 的 buttonVariants ===== -->
            <Style x:Key="AppButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="AppPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AppBrandBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBrandBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AppBrandFgBrush}" />
            </Style>
            <Style x:Key="AppSurfaceButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrongBrush}" />
            </Style>
            <Style x:Key="AppGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource AppMutedFgBrush}" />
            </Style>
            <Style x:Key="AppDestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AppDestructiveSoftBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppDestructiveSoftBorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AppDestructiveBrush}" />
            </Style>
            <Style x:Key="AppStopButtonStyle" TargetType="Button" BasedOn="{StaticResource AppDestructiveButtonStyle}" />
            <Style x:Key="AppWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AppWarningSoftBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppWarningSoftBorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AppWarningBrush}" />
            </Style>
            <Style x:Key="AppSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AppSuccessSoftBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppSuccessSoftBorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}" />
            </Style>
            <Style x:Key="AppIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="AppSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="11,0" />
            </Style>

            <!-- ===== 表单控件 ===== -->
            <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="11,6,11,7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource AppInputBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
                <Setter Property="PlaceholderForeground" Value="{StaticResource AppPlaceholderBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="AppPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="11,6,11,7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource AppInputBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="AppComboBoxStyle" TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource AppInputBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
            </Style>
            <Style x:Key="AppNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFontMono}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource AppInputBrush}" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
            </Style>
            <Style x:Key="AppToggleSwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
            </Style>
            <Style x:Key="AppCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}" />
            </Style>
            <Style x:Key="AppListViewStyle" TargetType="ListView">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

            <!-- ===== 侧栏导航项：选中态 = 2px 品牌竖条 + accent 底 + 图标变品牌色 ===== -->
            <!--
              侧栏导航项：选中态 = 左侧 2px 品牌竖条 + accent 底色；
              图标与文字颜色由 MainWindow 在选中/悬停时切换（FontIcon.Foreground 不是继承属性，
              模板里拿不到内容树的图标，所以配色走代码，这里只负责竖条与底色）。
            -->
            <Style x:Key="AppNavItemStyle" TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{StaticResource AppFontSans}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Height" Value="40" />
                <!-- 默认模板带 MinWidth=120，折叠成 60px 侧栏时会把内容顶出边界。 -->
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="14,0,0,0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                                <Rectangle x:Name="Indicator"
                                           Width="2" HorizontalAlignment="Left"
                                           Fill="{StaticResource AppBrandBrush}"
                                           Visibility="Collapsed" />
                                <ContentPresenter x:Name="Content"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator"
                                                                               Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator"
                                                                               Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Indicator"
                                                                               Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
