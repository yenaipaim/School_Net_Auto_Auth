<Application x:Class="SchoolNetAutoAuth.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Microsoft.UI.Xaml.Controls"
             RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AppNavigationPaneBackgroundBrush" Color="#F3F5F7" />
            <SolidColorBrush x:Key="AppNavigationItemBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AppNavigationItemSelectedBackgroundBrush" Color="#DCEBFF" />
            <SolidColorBrush x:Key="AppNavigationItemPointerOverBackgroundBrush" Color="#E8EEF5" />
            <SolidColorBrush x:Key="AppNavigationItemForegroundBrush" Color="#243447" />
            <SolidColorBrush x:Key="AppNavigationItemSelectedForegroundBrush" Color="#0B5CAD" />
            <SolidColorBrush x:Key="AppNavigationItemIconForegroundBrush" Color="#526579" />
            <SolidColorBrush x:Key="AppNavigationItemSelectedIconForegroundBrush" Color="#0B5CAD" />
            <Style x:Key="AppButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#243447" />
                <Setter Property="BorderBrush" Value="#AAB7C4" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style x:Key="AppPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="#0078D4" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#0067B8" />
            </Style>
            <Style x:Key="AppStopButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="#FFF0F0" />
                <Setter Property="Foreground" Value="#A4262C" />
                <Setter Property="BorderBrush" Value="#E0A3A6" />
            </Style>
            <Style x:Key="AppWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="#FFF4E5" />
                <Setter Property="Foreground" Value="#7A4B00" />
                <Setter Property="BorderBrush" Value="#E2B66F" />
            </Style>
            <Style x:Key="AppSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
                <Setter Property="Background" Value="#EAF6EE" />
                <Setter Property="Foreground" Value="#176B36" />
                <Setter Property="BorderBrush" Value="#9AC9A8" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
